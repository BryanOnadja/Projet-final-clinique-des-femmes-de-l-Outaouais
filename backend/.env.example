# Copiez ce fichier en « .env » (même dossier) puis adaptez les valeurs.
# Le fichier .env n'est JAMAIS envoyé sur GitHub (voir .gitignore).

# MySQL (XAMPP : utilisateur root, mot de passe vide par défaut)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clinique_appels

# Secret qui signe les jetons de connexion : mettez une longue phrase au hasard
JWT_SECRET=remplacez-moi-par-une-longue-phrase-secrete

# Serveur
PORT=4000
CLIENT_URL=http://localhost:5173
