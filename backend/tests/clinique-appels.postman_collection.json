                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Liste des appels actifs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jeton}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appels"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Renvoie un tableau d'appels non archivés\", function () {",
                  "  const appels = pm.response.json();",
                  "  pm.expect(appels).to.be.an(\"array\");",
                  "  appels.forEach(a => pm.expect(a.archive).to.eql(0));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Recherche par numéro (actifs + archives)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jeton}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appels?archive=tous&q=8195550142",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appels"
              ],
              "query": [
                {
                  "key": "archive",
                  "value": "tous"
                },
                {
                  "key": "q",
                  "value": "8195550142"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Tous les résultats ont ce numéro\", function () {",
                  "  pm.response.json().forEach(a => pm.expect(a.telephone_chiffres).to.include(\"8195550142\"));",
                  "});"
                ]
              }
            }
          ]
        },
