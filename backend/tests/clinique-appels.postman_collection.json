                  "});",
                  "pm.test(\"L'appel créé est nouveau\", function () {",
                  "  const a = pm.response.json();",
                  "  pm.expect(a.statut).to.eql(\"nouveau\");",
                  "  pm.collectionVariables.set(\"appelId\", a.id);",
                  "});"
                ]
              }
            }
          ]
        },
