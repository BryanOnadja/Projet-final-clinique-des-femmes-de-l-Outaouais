{
  "info": {
    "name": "Suivi des appels – Clinique des femmes de l'Outaouais",
    "description": "Tests de l'API Express (SED 2515). Lancez le back-end (npm run dev), puis « Run collection ». La première requête enregistre le jeton utilisé par les suivantes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Connexion",
      "item": [
        {
          "name": "Connexion réussie (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courriel\": \"admin@clinique.test\",\n  \"mot_de_passe\": \"Demo123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Reçoit un jeton\", function () {",
                  "  const r = pm.response.json();",
                  "  pm.expect(r.jeton).to.be.a(\"string\");",
                  "  pm.expect(r.utilisateur.role).to.eql(\"admin\");",
                  "  pm.collectionVariables.set(\"jeton\", r.jeton); // utilisé par toutes les requêtes suivantes",
                  "});"
                ]
              }
            }
          ]
        },
